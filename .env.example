# ============================================================
# docker compose 用的环境变量模板
#   cp .env.example .env  然后按需填写
#   ⚠️ .env 已在 .gitignore 里，不会被提交
# ============================================================

# ---------- 数据库 ----------
# 只在「首次初始化数据目录」时生效；改完要删掉 ./data/mysql 重新初始化
MYSQL_ROOT_PASSWORD=123456

# ---------- AI 模型（必填，否则只能看界面、不能生成）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智能路由用的轻量模型（阿里云百炼），留空会自动降级到 DeepSeek
ROUTING_API_KEY=

# ---------- 对象存储（可选：上传头像 / 生成应用封面才用）----------
COS_HOST=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=

# ---------- 部署 ----------
# 部署地址是给浏览器看的；容器内截图访问它需要宿主机 8080 有 Nginx（见 README）
APP_DEPLOY_HOST=http://localhost:8080
